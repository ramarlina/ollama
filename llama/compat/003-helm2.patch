--- a/common/common.cpp
+++ b/common/common.cpp
@@ -1250,6 +1250,21 @@ common_init_result::common_init_result(common_params & params, bool model_only)
 
     pimpl->model.reset(model);
 
+    // Saina Helm 2 (decision.type helm2) reads one final hidden state per
+    // question. Its backbone is causal, so the prompt runs in ordinary batches.
+    {
+        char arch[128], decision[16];
+        if (llama_model_meta_val_str(model, "general.architecture", arch, sizeof(arch)) >= 0 &&
+                llama_model_meta_val_str(model, (std::string(arch) + ".decision.type").c_str(), decision,
+                                         sizeof(decision)) >= 0 &&
+                std::strcmp(decision, "helm2") == 0) {
+            params.embedding = cparams.embeddings = true;
+            cparams.ctx_type = LLAMA_CONTEXT_TYPE_DECISION;
+            params.pooling_type = cparams.pooling_type = LLAMA_POOLING_TYPE_NONE;
+            params.n_outputs_max = cparams.n_outputs_max = 0; // n_batch
+        }
+    }
+
     if (model_only) {
         return;
     }
