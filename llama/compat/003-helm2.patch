+    // Saina Helm 2: apply the routed head at each question's readout token.
+    void send_helm2_scores(const server_slot & slot) {
+        auto res = std::make_unique<server_task_result_embd>();
+        res->id        = slot.task->id;
+        res->index     = slot.task->index;
+        res->n_tokens  = slot.task->n_tokens();
+        res->res_type  = slot.task->params.res_type;
+        try {
+            if (slot.score_embeddings.size() != size_t(slot.task->n_tokens())) {
+                throw std::runtime_error("decision model did not return every hidden state");
+            }
+            if (!helm2) helm2.reset(new helm2_head(params_base.model.path));
+            res->score_logits = helm2->score(slot.score_embeddings, slot.task->score_fields);
+        } catch (const std::exception & e) {
+            send_error(slot, e.what(), ERROR_TYPE_SERVER);
+            return;
+        }
+        queue_results.send(std::move(res));
+    }
